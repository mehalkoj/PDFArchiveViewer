{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Port the site runs on. Other PCs browse to http://<this-computer-ip>:5000
  // This port can also be changed!
  "Urls": "http://*:5000",

  // Use forward slashes, OR double every backslash: "\\\\fileserver01\\home\\folder1"
  "ArchiveRootFolder": "//127.0.0.1/UNCTestShare/Categories/",

  // Change format of date (if pdfs are named after dates)
  "Format": "yyyyMMdd",

  // Title shown at the top of the site
  "SiteTitle": "Test Archive Viewer",

  // Header image that appears top left.
  "SiteImage": "",

  // Rename folders on screen. Left = real folder name, right = name users see.
  // EX: "NP1": "Newspaper 1"
  "FolderDisplayNames": {
    "NP1": "Newspaper 1",
    "NP2": "Newspaper 2",
    "NP3": "Newspaper 3"

  }
}
